if(length(areas) < 2){
return(NULL)
}
edges <- data.frame(from = head(areas, -1), to = tail(areas, -1))
node_freq <- table(df$Area)
g <- graph_from_data_frame(edges, directed = TRUE)
V(g)$freq <- as.numeric(node_freq[match(V(g)$name, names(node_freq))])
return(list(graph = g, edges = edges,node_freq = node_freq))
}
